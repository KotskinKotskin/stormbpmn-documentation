TIMEZONE=Europe/Moscow
# Версия приложения: последняя — в разделе Changelog документации
STORMBPMN_VERSION=
# Логин и секрет robot-аккаунта из портала Enterprise (раздел «Доступ к образам»).
# Одинарные кавычки обязательны: в логине есть символ $.
REGISTRY_USERNAME=''
REGISTRY_PASSWORD=''
# Необязательно: IP или DNS-имя сервера, по которому пользователи откроют Stormbpmn.
# Если не задано, берётся первый IP сервера.
STORMBPMN_HOST=
